{
  "name": "@hayashiii/sitesnap",
  "version": "0.2.1",
  "description": "AI-friendly CLI for capturing website screenshots (desktop + mobile) with sitemap support and per-domain organization. Built for portfolio reference collection.",
  "type": "module",
  "bin": {
    "sitesnap": "cli.mjs"
  },
  "files": [
    "cli.mjs",
    "src/",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/**.test.mjs",
    "site": "bun cli.mjs site",
    "page": "bun cli.mjs page",
    "list": "bun cli.mjs list",
    "open": "bun cli.mjs open",
    "retry": "bun cli.mjs retry",
    "help": "bun cli.mjs help"
  },
  "keywords": [
    "screenshot",
    "playwright",
    "sitemap",
    "portfolio",
    "cli",
    "ai-agent",
    "claude-code",
    "web-archive",
    "responsive"
  ],
  "author": "Hayashi <hay@shigoto.dev>",
  "license": "MIT",
  "homepage": "https://github.com/hayashiii-ghub/sitesnap#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hayashiii-ghub/sitesnap.git"
  },
  "bugs": {
    "url": "https://github.com/hayashiii-ghub/sitesnap/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "fast-xml-parser": "^5.7.2",
    "playwright": "^1.59.1"
  }
}
